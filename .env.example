# Uganda PostgreSQL credentials.
#
# Copy this file to .env and fill in the values. .env is gitignored — it
# never leaves your machine. .env.example IS committed so teammates know
# which variables to set.
#
# DataGrip stores the same connection details under
#   uganda@192.168.203.7  (Database Explorer panel)

PGHOST=192.168.203.7
PGPORT=5432
PGDATABASE=uganda
PGUSER=
PGPASSWORD=
